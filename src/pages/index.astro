		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO tags -->
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Hunter Mansson" />
		<link rel="canonical" href={siteUrl} />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Hunter Mansson" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data: helps Google show a rich "Person" result -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Hunter Mansson",
			"url": siteUrl,
			"image": ogImage,
			"jobTitle": "Computer Science Student",
			"affiliation": {
				"@type": "CollegeOrUniversity",
				"name": "North Carolina State University"
			},
			"alumniOf": [
				{
					"@type": "CollegeOrUniversity",
					"name": "North Carolina State University"
				},
				{
					"@type": "CollegeOrUniversity",
					"name": "Forsyth Technical Community College"
				}
			],
			"sameAs": [
				"https://www.linkedin.com/in/hunter-mansson-517159320",
				"https://github.com/hrmp-1",
				"https://www.instagram.com/huntermansson/"
			],
			"knowsAbout": [
				"Swift", "SwiftUI", "Core Data", "CloudKit", "Python",
				"iOS Development", "macOS Development", "Java", "Astro"
			]
		})} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
