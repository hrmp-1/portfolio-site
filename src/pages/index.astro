<script>
	setup();

	document.addEventListener('astro:page-load', setup);

	function setup() {
	const navButtons = document.querySelectorAll('.nav-pill');
	const sections = document.querySelectorAll('.section');
	const nav = document.querySelector('nav');

	let currentSection = 'nil';

	const updateNavPosition = () => {
		if (window.scrollY > 0) {
			nav?.classList.remove('top-20');
			nav?.classList.add('top-4');
		} else {
			nav?.classList.remove('top-4');
			nav?.classList.add('top-20');
		}
	};

	updateNavPosition();

	window.addEventListener('scroll', () => {
		updateNavPosition();

		sections.forEach(section => {
			const htmlElement = section as HTMLElement;
			if (window.scrollY >= htmlElement.offsetTop) {
				currentSection = htmlElement.id;
			}

			if (window.scrollY === 0) {
				currentSection = 'nil';
			}
		});

		navButtons.forEach(button => {
			const htmlElement = button as HTMLAnchorElement;

			if (htmlElement.href.includes(currentSection)) {
				htmlElement.classList.add('active')
			} else {
				htmlElement.classList.remove('active')
			}
		})
	});
}
</script>