---
import ProjectCard from "../components/projectCard.astro";

const projects = [
    { 
        name: "Groopd", 
        language: "swift", 
        description: `
            A real-time, shared grocery planner built natively for the Apple ecosystem to 
            eliminate household purchasing conflicts. Leverages CoreData and CloudKit Zone Sharing 
            for multi-user synchronization across devices, allowing families and roommates to manage a live, 
            unified shopping list seamlessly.
        `, 
        url: "/projects/groopd",
        iconurl: "/groopdicon.png",
        wip: true
    },
    { 
        name: "Notarik", 
        language: "swift", 
        description: `
            A modern speed-reading document reader utilizing the RSVP (Rapid Serial Visual Presentation) technique. 
            Features asynchronous background PDF processing powered by Swift Concurrency, integrated with CoreData and 
            CloudKit for cloud sync, with planned AI-driven comprehension tools.
        `,
        url: "/projects/notarik",
        iconurl: "/notarikicon.png",
        wip: true
    },
    { 
        name: "Portfolio Site", 
        language: "astro", 
        description: `
            A fast, static portfolio built with Astro and Tailwind CSS. Designed with the goal of 
            being a fast, low cost, and visually pleasing website.
        `,
        url: "/projects/portfoliosite",
        iconurl: "/favicon.png",
        wip: true
    }
]

---
<div class="flex flex-col h-1/2 p-5 overflow-hidden glass w-3/4">
    <main class="grow flex flex-col gap-3 pt-3 min-h-0 overflow-hidden">
        <div class="flex flex-row justify-between flex-wrap gap-3">
            <div class="flex gap-3 flex-wrap">
                <button data-filter="all" class="code-pill border-black hover:bg-black [&.active]:bg-black">all</button>
                <button data-filter="swift" class="code-pill border-[#F05138] hover:bg-[#F05138] [&.active]:bg-[#F05138]">swift</button>
                <!-- <button data-filter="python" class="code-pill border-[#3776AB] hover:bg-[#3776AB] [&.active]:bg-[#3776AB]">python</button> -->
                <!-- <button data-filter="java" class="code-pill border-[#E61F25] hover:bg-[#E61F25] [&.active]:bg-[#E61F25]">java</button> -->
                <button data-filter="astro" class="code-pill border-[#EE46DD] hover:bg-[#EE46DD] [&.active]:bg-[#EE46DD]">astro</button>
            </div>
            <div class="text-white w-full justify-center items-center text-center">v Scroll to see more v</div>
        </div>
        
        <div id="projects_container" class="grow p-3 rounded-2xl shadow-2xl flex flex-col gap-3 overflow-y-auto min-h-0">
    
        </div>
    </main>
</div>

<script>
    updateGithubAsync();

    document.addEventListener('astro:page-load', updateGithubAsync);

    function updateGithubAsync() {
        const projects = document.getElementById('projects_container');
        console.log("Getting HTTP GET");

        fetch("https://api.github.com/users/hrmp-1/repos")
            .then((response) => {
                if (!response.ok) {
                    console.log(`Error getting Github Repos, response status: ${response.status}`);
                }
                return response.json(); // no need to manually JSON.parse text
            })
            .then((repos) => {
                for (const repo of repos) {
                    const lang = (repo.language || "other").toLowerCase();
                    console.log(`Adding repo: ${repo.name}`);

                    const valueMap: Record<string, string> = {
                        "java":  "bg-[#E61F25] border-[#E61F25]",
                        "python": "bg-[#3776AB] border-[#3776AB]",
                        "swift": "bg-[#F05138] border-[#F05138]",
                        "astro": "bg-[#EE46DD] border-[#EE46DD]",
                    }

                    const color = valueMap[lang] || "bg-[#000000] border-[#000000]";

                    projects?.insertAdjacentHTML("beforeend", `
                        <a href="${repo.html_url ?? ""}" data-language=${lang} class="project-card">
                            <div class="group relative flex w-full rounded-3xl shadow-sm p-3 gap-3 glass z-50 flex-col">
                                <div class="flex gap-3">
                                    <!-- <img class="rounded-2xl self-start shadow-lg relative z-10" src={iconurl} width="75" height="75"> -->
                                    <div class="relative z-10 flex flex-col gap-2">
                                        <div class="flex gap-3 flex-row flex-wrap">
                                            <div class="font-ubuntu font-bold text-white">
                                                ${repo.name ?? ""}
                                            </div>
                                            <div class="font-ubuntu text-xs border-2 rounded-full p-0.5 pl-4 pr-4 text-white ${color} text-center w-fit">
                                                ${lang}
                                            </div>
                                            <!-- <div>
                                                {wip && 
                                                <div class="font-ubuntu text-xs border-2 rounded-full p-0.5 pl-4 pr-4 text-white bg-amber-500 border-amber-500 w-fit">
                                                    WIP
                                                </div>}
                                            </div> -->
                                        </div>
                                        <div>
                                            <div class="font-ubuntu text-white text-sm flex">${repo.description ?? ""}</div>
                                        </div>
                                        <div class="hidden sm:flex font-ubuntu text-white text-sm group-hover:text-blue-400 transition duration-200">[Visit Github &minus;&minus;&gt;]</div>
                                    </div>
                                </div>
                                <div class="flex sm:hidden font-ubuntu text-white text-sm group-hover:text-blue-400 transition duration-200 w-full justify-center items-center text-center">[Visit Github &minus;&minus;&gt;]</div>
                            </div>
                        </a>
                    `);
                }

                setupFilters();
            })
            .catch((error) => {
                console.error(error);
                projects?.insertAdjacentHTML("beforeend", `
                    <div>Could not retrieve public repositories from Github</div>
                `);
            });
    }

    function setupFilters() {

        const buttons = document.querySelectorAll('.code-pill')
        const projectCards = document.querySelectorAll('.project-card')

        const allBtn = document.querySelector('[data-filter="all"]');
        if (allBtn) allBtn.classList.add('active');

        buttons.forEach(button => {
            button.addEventListener('click', () => {
                const filterValue = button.getAttribute('data-filter');

                // Update button styling
                buttons.forEach(btn => btn.classList.remove('active'))
                button.classList.add('active')

                // Filter the cards
                projectCards.forEach(card => {
                    const cardLang = card.getAttribute('data-language');

                    if (filterValue === 'all' || cardLang === filterValue) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden')
                    }
                })
            })
        })
    }
</script>